{
  "name": "vitalpredict-selenium-e2e",
  "version": "1.0.0",
  "description": "Enterprise Selenium E2E Test Suite for VitalPredict Web Application",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:auth": "jest tests/auth.test.js --runInBand --forceExit",
    "test:dashboard": "jest tests/dashboard.test.js --runInBand --forceExit",
    "test:appointments": "jest tests/appointments.test.js --runInBand --forceExit",
    "test:report": "jest tests/report.test.js --runInBand --forceExit",
    "test:navigation": "jest tests/navigation.test.js --runInBand --forceExit",
    "test:forms": "jest tests/forms.test.js --runInBand --forceExit",
    "report:generate": "node utils/reportGenerator.js",
    "report:excel": "node utils/excelGenerator.js"
  },
  "dependencies": {
    "selenium-webdriver": "^4.18.1",
    "exceljs": "^4.4.0",
    "date-fns": "^3.6.0",
    "uuid": "^9.0.0",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "reporters": [
      "default",
      ["jest-html-reporter", {
        "pageTitle": "VitalPredict Selenium E2E Report",
        "outputPath": "reports/execution-report.html",
        "includeFailureMsg": true,
        "includeConsoleLog": true
      }]
    ]
  }
}
