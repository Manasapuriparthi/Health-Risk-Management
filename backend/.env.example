# ===== VitalPredict Backend — Environment Variables =====
# Copy this file to .env and fill in your values.

# --- MongoDB ---
# Local development (default):
MONGODB_URI=mongodb://127.0.0.1:27017
# Cloud (MongoDB Atlas) — replace with your Atlas connection string:
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DB_NAME=health_risk_db

# --- Authentication ---
# Secret key for JWT token signing (generate a long random string for production)
SECRET_KEY=change-this-to-a-random-secret-in-production

# --- CORS ---
# Comma-separated list of allowed frontend origins. Use * for local dev.
# For production, set to your Vercel domain(s):
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*
